{
  "name": "@qq33357486/oh-my-task",
  "version": "1.4.22",
  "description": "文档驱动的 AI 编程协作系统 - 通过 MCP 工具管理任务",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "oh-my-task": "dist/mcp/server.js"
  },
  "files": [
    "dist",
    "src/db/schema.sql",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:all": "tsx scripts/dev.ts",
    "build": "node scripts/clean-dist.cjs && tsc && node scripts/copy-schema.cjs",
    "start": "node dist/index.js",
    "mcp": "tsx src/mcp/server.ts",
    "db:init": "tsx src/db/init.ts",
    "version": "npm run build",
    "release:patch": "npm version patch",
    "release:minor": "npm version minor",
    "release:major": "npm version major",
    "release:push": "git push origin master --follow-tags"
  },
  "keywords": [
    "task-management",
    "mcp",
    "ai-assistant"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@types/nodemailer": "^8.0.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^11.0.0",
    "better-sqlite3-session-store": "^0.1.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-session": "^1.19.0",
    "nodemailer": "^8.0.5",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.2",
    "@types/node": "^20.10.0",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^9.0.7",
    "supertest": "^7.2.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.4"
  }
}
